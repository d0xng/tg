# Telegram ingress + notifications. The bot is both the entry (send "domain + scope" to start a run)
# and the notifier (leads ready / findings ready). Leave empty to run only via the `hunt` CLI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model roster. Everything runs through your Max / ChatGPT subscriptions via the headless CLIs,
# NOT the API. These are pins you can change; "sol"/exact ids get confirmed against the live CLI.
JS_MODEL=gpt-6-sol
HUNTER1_MODEL=claude-opus-4-8
HUNTER2_MODEL=claude-opus-5-5
HUNTER3_MODEL=gpt-6-sol
VALIDATOR_MODEL=claude-opus-5-5
REPORTER_MODEL=claude-opus-5-5

# Reasoning effort. Codex takes this as a config key; the exact key/value is verified in `doctor`.
EFFORT=xhigh
CODEX_EFFORT_CONFIG=model_reasoning_effort="xhigh"

# Soft concurrency. The real limit is subscription quota: the two Claude hunters share your Max pool,
# the two GPT agents share your ChatGPT pool. The orchestrator paces to these, it never asks you.
CLAUDE_CONCURRENCY=2
CODEX_CONCURRENCY=1
SUBAGENTS_MAX=3

# Runtime
CHROME_BIN=google-chrome
# HUNTLINE_RUNS=/custom/runs/dir
